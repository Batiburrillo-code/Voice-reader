{
  "manifest_version": 3,
  "name": "Lector TTS",
  "version": "1.0.0",
  "description": "Lee páginas web y PDFs en voz alta con resaltado de texto, tipo Speechify. 100% gratis, sin servicios externos.",
  "minimum_chrome_version": "121",

  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["libs/Readability.js", "speech-engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Lector TTS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "commands": {
    "leer-seleccion": {
      "suggested_key": { "default": "Alt+L" },
      "description": "Leer la selección en voz alta (o la página completa si no hay nada seleccionado)"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "lector-tts@adrian.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
